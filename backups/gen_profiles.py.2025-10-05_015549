#!/usr/bin/env python
from __future__ import annotations
import argparse, json, math, random
from pathlib import Path
from typing import Dict, Any, List, Tuple

import numpy as np
import pandas as pd

from app.data_providers import get_ohlcv
from app.opt_core import evaluate_candidate, pack_profile

def sample_params() -> Dict[str, Any]:
    # En rimlig parameter-yta (kan justeras senare)
    use_rsi = random.random() < 0.8
    use_macd = random.random() < 0.4
    use_trend = random.random() < 0.3
    use_bb = random.random() < 0.3
    use_sl = random.random() < 0.5
    use_atr_trail = random.random() < 0.5

    p = {
        "use_rsi_filter": use_rsi,
        "rsi_window": random.randint(8, 35),
        "rsi_min": round(random.uniform(15, 35), 3),
        "rsi_max": round(random.uniform(60, 80), 3),

        "use_trend_filter": use_trend,
        "trend_ma_type": random.choice(["SMA","EMA"]),
        "trend_ma_window": random.randint(50, 220),

        "breakout_lookback": random.randint(10, 60),
        "exit_lookback": random.randint(8, 55),

        "use_macd_filter": use_macd,
        "macd_fast": random.randint(8, 18),
        "macd_slow": random.randint(16, 30),
        "macd_signal": random.randint(6, 14),

        "use_bb_filter": use_bb,
        "bb_window": random.randint(12, 35),
        "bb_nstd": round(random.uniform(1.5, 2.8), 3),
        "bb_min": round(random.uniform(0.0, 0.8), 3),

        "use_stop_loss": use_sl,
        "stop_mode": "pct",
        "stop_loss_pct": round(random.uniform(0.05, 0.2), 3),

        "atr_window": random.randint(10, 22),
        "atr_mult": round(random.uniform(1.3, 3.2), 3),
        "use_atr_trailing": use_atr_trail,
        "atr_trail_mult": round(random.uniform(1.0, 3.0), 3),

        "initial_equity": 100_000,
    }
    return p

def score_conservative(m: Dict[str, Any]) -> float:
    tr = float(m.get("TotalReturn", float("-inf")))
    dd = abs(float(m.get("MaxDD", 0.0) or 0.0))
    return tr - 1.2 * dd

def score_balanced(m: Dict[str, Any]) -> float:
    tr = float(m.get("TotalReturn", float("-inf")))
    dd = abs(float(m.get("MaxDD", 0.0) or 0.0))
    return tr - 0.7 * dd

def score_aggressive(m: Dict[str, Any]) -> float:
    tr = float(m.get("TotalReturn", float("-inf")))
    dd = abs(float(m.get("MaxDD", 0.0) or 0.0))
    return tr - 0.2 * dd

def main():
    pa = argparse.ArgumentParser(description="Generera 3 profiler (conservative/balanced/aggressive) och spara i profiles/<TICKER>.json")
    pa.add_argument("ticker", help="Börsdata-ticker, t.ex. YUBICO eller GETI B")
    pa.add_argument("--start", default="2020-10-04")
    pa.add_argument("--end", default=None)
    pa.add_argument("--samples", type=int, default=200, help="antal slumpade kandidater att testa")
    pa.add_argument("--seed", type=int, default=42)
    args = pa.parse_args()

    random.seed(args.seed)
    np.random.seed(args.seed)

    df = get_ohlcv(args.ticker, start=args.start, end=args.end)
    if df is None or len(df) < 50:
        raise SystemExit(f"Kunde inte hämta data för {args.ticker} ({args.start}→{args.end}).")

    tested: List[Tuple[Dict[str,Any], Dict[str,Any]]] = []  # (params, metrics)

    for i in range(args.samples):
        params = sample_params()
        params["from_date"] = args.start
        if args.end: params["to_date"] = args.end
        try:
            m = evaluate_candidate(df, params, return_series=True)
            tested.append((params, m))
        except Exception as e:
            # hoppa denna kandidat
            continue

    if not tested:
        raise SystemExit("Inga kandidater gick att utvärdera.")

    # Rangordna
    cons = sorted(tested, key=lambda x: score_conservative(x[1]), reverse=True)[0]
    bal  = sorted(tested, key=lambda x: score_balanced(x[1]),     reverse=True)[0]
    aggr = sorted(tested, key=lambda x: score_aggressive(x[1]),   reverse=True)[0]

    profiles = [
        pack_profile(args.ticker, "conservative", cons[0], cons[1]),
        pack_profile(args.ticker, "balanced",     bal[0],  bal[1]),
        pack_profile(args.ticker, "aggressive",   aggr[0], aggr[1]),
    ]

    out = {"profiles": profiles}
    Path("profiles").mkdir(parents=True, exist_ok=True)
    out_path = Path("profiles") / f"{args.ticker}.json"
    out_path.write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"[OK] Sparade: {out_path}")
    print("  TR (cons/bal/agg):", *(round(p['metrics']['TotalReturn'],4) for p in profiles))
    print("  BH (cons/bal/agg):", *(round(p['metrics']['BuyHold'],4)     for p in profiles))
    print("  DD (cons/bal/agg):", *(round(p['metrics'].get('MaxDD', float('nan')),4) for p in profiles))
    print("  SharpeD:", *(round(p['metrics'].get('SharpeD', float('nan')),3) for p in profiles))

if __name__ == "__main__":
    main()
