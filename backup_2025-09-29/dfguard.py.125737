# -*- coding: utf-8 -*-
# Gör inkommande objekt till en robust pandas.DataFrame och säkerställ OHLCV-kolumner.
from typing import Any
import pandas as pd
import numpy as np

def _ensure_ohlcv_variants(df: pd.DataFrame) -> pd.DataFrame:
    pairs = [("open","Open"), ("high","High"), ("low","Low"), ("close","Close"), ("volume","Volume")]
    cols = set(df.columns)
    # skapa TitleCase från lowercase
    for low, cap in pairs:
        if low in cols and cap not in cols:
            df[cap] = df[low]
    cols = set(df.columns)
    # skapa lowercase från TitleCase
    for low, cap in pairs:
        if cap in cols and low not in cols:
            df[low] = df[cap]
    # försök numeriska typer
    for low, cap in pairs:
        for c in (low, cap):
            if c in df.columns:
                try:
                    df[c] = pd.to_numeric(df[c], errors="coerce")
                except Exception:
                    pass
    return df

def to_dataframe(obj: Any) -> pd.DataFrame:
    if obj is None:
        raise TypeError("df is None")

    if isinstance(obj, pd.DataFrame):
        df = obj.copy()
    elif isinstance(obj, (list, tuple)):
        # list/tuple av dicts → DataFrame
        if len(obj) and isinstance(obj[0], dict):
            df = pd.DataFrame(list(obj))
        else:
            df = pd.DataFrame(obj)
    elif isinstance(obj, dict):
        # dict av listor/serier → DataFrame
        try:
            df = pd.DataFrame(obj)
        except Exception:
            # försök med 'data'-nyckel
            data = obj.get("data") if hasattr(obj, "get") else None
            if isinstance(data, (list, tuple)):
                df = pd.DataFrame(list(data))
            else:
                raise
    else:
        # sista chans: metod to_pandas()
        if hasattr(obj, "to_pandas"):
            df = obj.to_pandas()
        else:
            df = pd.DataFrame(obj)

    # sätt datumindex om kolumn finns
    if "date" in df.columns and not isinstance(df.index, pd.DatetimeIndex):
        try:
            df["date"] = pd.to_datetime(df["date"])
            df = df.set_index("date", drop=True)
        except Exception:
            pass
    elif "Date" in df.columns and not isinstance(df.index, pd.DatetimeIndex):
        try:
            df["Date"] = pd.to_datetime(df["Date"])
            df = df.set_index("Date", drop=True)
        except Exception:
            pass

    # säkerställ OHLCV-varianter
    df = _ensure_ohlcv_variants(df)

    # sanity: sorterat index
    try:
        if isinstance(df.index, pd.DatetimeIndex):
            df = df.sort_index()
    except Exception:
        pass

    return df
